<idea-plugin>
    <id>io.github.baddel73.dots</id>
    <name>DOTS Language Support</name>
    <vendor email="s.rechlin@me.com">Sebastian Rechlin</vendor>
    <description>Support for DOTS (Distributed Objects in Time and Space) language</description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Dateityp-Registrierung -->
        <fileType
            name="DOTS"
            implementationClass="io.github.baddel73.dots.file.DotsFileType"
            fieldName="INSTANCE"
            language="DOTS"
            extensions="dots"/>
        <lang.syntaxHighlighterFactory
                language="DOTS"
                implementationClass="io.github.baddel73.dots.language.DotsSyntaxHighlighterFactory"/>
        <lang.parserDefinition
                language="DOTS"
                implementationClass="io.github.baddel73.dots.language.DotsParserDefinition"/>
        <colorSettingsPage
                implementation="io.github.baddel73.dots.language.DotsColorSettingsPage"/>
        <annotator language="DOTS" implementationClass="io.github.baddel73.dots.language.DotsAnnotator"/>
    </extensions>
</idea-plugin>